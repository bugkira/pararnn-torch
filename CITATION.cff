cff-version: 1.2.0
title: pararnn-torch
message: >-
  If you use this software, please cite both this repository and the ParaRNN paper below.
type: software
authors:
  - family-names: Sereda
    given-names: Daniil
repository-code: "https://github.com/bugkira/pararnn-torch"
url: "https://github.com/bugkira/pararnn-torch"
license: MIT
abstract: >-
  PyTorch implementation of ParaRNN (Danieli et al., ICLR 2026): parallel
  training of nonlinear RNNs via Newton iterations and an associative scan.
  Official CUDA kernels: https://github.com/apple/ml-pararnn (custom license).
keywords:
  - rnn
  - lstm
  - gru
  - slstm
  - xlstm
  - newton
  - parallel-scan
  - pytorch
  - triton
preferred-citation:
  type: conference-paper
  authors:
    - family-names: Danieli
      given-names: Federico
    - family-names: Rodriguez
      given-names: Pau
    - family-names: Sarabia
      given-names: Miguel
    - family-names: Suau
      given-names: Xavier
    - family-names: Zappella
      given-names: Luca
  title: >-
    ParaRNN: Unlocking Parallel Training of Nonlinear RNNs for Large Language Models
  year: 2026
  conference:
    name: International Conference on Learning Representations
  url: "https://arxiv.org/abs/2510.21450"
  doi: 10.48550/arXiv.2510.21450
